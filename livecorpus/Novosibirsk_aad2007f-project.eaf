        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a129"
                TIME_SLOT_REF1="ts3583" TIME_SLOT_REF2="ts3607">
                <ANNOTATION_VALUE>кролик вообще его покупали мне</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a130"
                TIME_SLOT_REF1="ts3615" TIME_SLOT_REF2="ts3641">
                <ANNOTATION_VALUE>мне его купили на день рождения</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a131"
                TIME_SLOT_REF1="ts3647" TIME_SLOT_REF2="ts3696">
                <ANNOTATION_VALUE>но где-то через год я устала за ним ухаживать</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a132"
                TIME_SLOT_REF1="ts3699" TIME_SLOT_REF2="ts3728">
                <ANNOTATION_VALUE>потому что она засранка мягко говоря</ANNOTATION_VALUE>
