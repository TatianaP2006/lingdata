        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a133"
                TIME_SLOT_REF1="ts3731" TIME_SLOT_REF2="ts3753">
                <ANNOTATION_VALUE>предыдущий кролик таким не был</ANNOTATION_VALUE>
