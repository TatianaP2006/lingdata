        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a2069"
                TIME_SLOT_REF1="ts12" TIME_SLOT_REF2="ts137">
                <ANNOTATION_VALUE>Подобные адапторы встречаются на большей части видео и дальше не отмечены</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1784"
                TIME_SLOT_REF1="ts959" TIME_SLOT_REF2="ts973">
                <ANNOTATION_VALUE>Скорее всего физиологический жест - поправить волосы, запрокинув голову. Повторяется несколько раз дальше, не размечены</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1901"
                TIME_SLOT_REF1="ts1313" TIME_SLOT_REF2="ts1339">
                <ANNOTATION_VALUE>Тут жест рук возможно скорее адаптор</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1932"
                TIME_SLOT_REF1="ts1878" TIME_SLOT_REF2="ts1891">
                <ANNOTATION_VALUE>Здесь жест рук тоже скорее адаптор</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1956"
                TIME_SLOT_REF1="ts2284" TIME_SLOT_REF2="ts2308">
                <ANNOTATION_VALUE>Жест рук - веротяно адаптор </ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a2048"
                TIME_SLOT_REF1="ts3538" TIME_SLOT_REF2="ts3568">
                <ANNOTATION_VALUE>Жест рук - скорее адаптор</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1857"
                TIME_SLOT_REF1="ts3651" TIME_SLOT_REF2="ts3686">
                <ANNOTATION_VALUE>У рук здесь движение исключительно для того, чтобы поправить пиджак</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1862"
                TIME_SLOT_REF1="ts3786" TIME_SLOT_REF2="ts3813">
                <ANNOTATION_VALUE>у рук точно физиологический жест - потянуться, у головы вроде нет</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
