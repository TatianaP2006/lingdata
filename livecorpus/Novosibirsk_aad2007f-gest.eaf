        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a29"
                TIME_SLOT_REF1="ts1" TIME_SLOT_REF2="ts11">
                <ANNOTATION_VALUE>что-нибудь про Новосибирск</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a13"
                TIME_SLOT_REF1="ts13" TIME_SLOT_REF2="ts15">
                <ANNOTATION_VALUE>Новосибирск</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a14"
                TIME_SLOT_REF1="ts17" TIME_SLOT_REF2="ts36">
                <ANNOTATION_VALUE>третий по численности населения город России</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a15"
                TIME_SLOT_REF1="ts38" TIME_SLOT_REF2="ts46">
                <ANNOTATION_VALUE>у нас эээ</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a251"
                TIME_SLOT_REF1="ts48" TIME_SLOT_REF2="ts59">
                <ANNOTATION_VALUE>самая большая прямая дорога</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a254"
                TIME_SLOT_REF1="ts60" TIME_SLOT_REF2="ts73">
                <ANNOTATION_VALUE>которую насколько я помню</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a255"
                TIME_SLOT_REF1="ts72" TIME_SLOT_REF2="ts85">
                <ANNOTATION_VALUE>немножечко сделали не прямой</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a253"
                TIME_SLOT_REF1="ts86" TIME_SLOT_REF2="ts106">
                <ANNOTATION_VALUE>и теперь этот факт немножечко сомнителен</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a17"
                TIME_SLOT_REF1="ts111" TIME_SLOT_REF2="ts122">
                <ANNOTATION_VALUE>но тем не менее</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a18"
                TIME_SLOT_REF1="ts124" TIME_SLOT_REF2="ts130">
                <ANNOTATION_VALUE>интересный факт</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a19"
                TIME_SLOT_REF1="ts132" TIME_SLOT_REF2="ts137">
                <ANNOTATION_VALUE>ааа что</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a257"
                TIME_SLOT_REF1="ts138" TIME_SLOT_REF2="ts144">
                <ANNOTATION_VALUE>Новосибирск образовался</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a258"
                TIME_SLOT_REF1="ts145" TIME_SLOT_REF2="ts169">
                <ANNOTATION_VALUE>потому что у нас там провели железную дорогу</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a259"
                TIME_SLOT_REF1="ts170" TIME_SLOT_REF2="ts212">
                <ANNOTATION_VALUE>и у нас до сих пор на набережной стоит кусок старый этой железной дороги</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a260"
                TIME_SLOT_REF1="ts213" TIME_SLOT_REF2="ts226">
                <ANNOTATION_VALUE>разумеется она не функционирует</ANNOTATION_VALUE>
