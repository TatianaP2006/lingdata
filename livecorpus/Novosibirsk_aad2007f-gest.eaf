                <ANNOTATION_VALUE>и он у нас</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a25"
                TIME_SLOT_REF1="ts369" TIME_SLOT_REF2="ts402">
                <ANNOTATION_VALUE>ещё у нас есть ээ классный оперный театр в центре города</ANNOTATION_VALUE>
