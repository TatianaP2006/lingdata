                <ANNOTATION_VALUE>он то ли бо= самый большой в России даже в Евразии</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a264"
